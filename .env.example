# === auth ===
APP_PASSWORD=change-me
SESSION_SECRET=change-me-too-32-bytes-min-please

# Bearer used between Nuxt server (Mastra) and FastAPI; randomly generated per environment
INTERNAL_BEARER=change-me-internal-bearer

# === LLM ===
# Pick ANY provider/model the Mastra registry supports. Format: "<provider>/<model-id>".
# Examples:
#   anthropic/claude-sonnet-4-6   anthropic/claude-haiku-4-5
#   openai/gpt-4o                 openai/gpt-4o-mini
#   google/gemini-2.5-pro         google/gemini-2.5-flash
#   deepseek/deepseek-chat        deepseek/deepseek-reasoner
# Only the API key for the provider you actually pick needs a real value.
LLM_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# === moomoo OpenD (host install) ===
OPEND_HOST=host.docker.internal
OPEND_PORT=11111

# === postgres ===
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=ai_trader
POSTGRES_DB=ai_trader
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_trader:ai_trader@postgres:5432/ai_trader

# === ports published to host ===
WEB_PORT=3000

# === search ===
TAVILY_API_KEY=tvly-...
