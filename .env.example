# === auth ===
APP_PASSWORD=change-me
SESSION_SECRET=change-me-too-32-bytes-min-please

# Bearer used between the Nuxt server and FastAPI. Generate with:
#   openssl rand -base64 32
# The web service refuses to start while this or ENCRYPTION_KEY is still a
# change-me value or shorter than 32 characters.
INTERNAL_BEARER=change-me-internal-bearer

# Encrypts the LLM provider API keys stored in the database. Generate with:
#   openssl rand -base64 32
# Keep it stable: if it changes, stored keys become unreadable and must be
# re-entered in Settings. Deliberately separate from SESSION_SECRET.
ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32

# === LLM ===
# Model providers, keys, and the chat and quick models are set in the app
# under Settings. Upgrading from LLM_MODEL / *_API_KEY here? Leave them in
# place for the first start: web imports them into Settings once, after which
# they can be deleted.

# === moomoo OpenD (host install) ===
OPEND_HOST=host.docker.internal
OPEND_PORT=11111
# RSA-1024 PKCS#1 private key path (inside the api container) shared with
# OpenD. Required for trade RPCs when api connects from a non-loopback host;
# quote RPCs work without it. Generate once and rebuild the api image:
#   openssl genrsa -traditional -out apps/api/secrets/futu_rsa.key 1024
#   docker compose up -d --build api
# Start OpenD on the host with -rsa_pri_key_path pointed at the same file.
OPEND_RSA_KEY_PATH=/app/secrets/futu_rsa.key
# Currency the moomoo account scalars (cash / market_val / total_assets) are
# reported in. moomoo's accinfo_query defaults to HKD and exposes no per-account
# base currency to detect, so set this to what your account actually reports in.
# One of AUD/CAD/CNH/HKD/JPY/MYR/SGD/USD.
MOOMOO_REPORT_CURRENCY=MYR

# === postgres ===
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=ai_trader
POSTGRES_DB=ai_trader
POSTGRES_PORT=5432
# DATABASE_URL is composed from the parts above by docker-compose at runtime.
# You only need to set this if running drizzle-kit / scripts on the host:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# === ports published to host ===
WEB_PORT=3000

# === search ===
# Set both keys; SEARCH_PROVIDER picks the primary, the other is the fallback.
SEARCH_PROVIDER=brave         # brave | tavily
BRAVE_API_KEY=BSA...          # https://api.search.brave.com (free tier: 2k req/mo)
TAVILY_API_KEY=tvly-...       # https://tavily.com (free tier: 1k req/mo)

# === ghostfolio MCP (cross-broker portfolio aggregation) ===
# Point at your remote ghostfolio-mcp endpoint (we don't run a local container —
# you BYO MCP server). Leave empty to disable; the agent simply won't see the
# ghostfolio_* tools and the system prompt adapts. Only a read-only subset of
# the server's tools is ever exposed to the chat model (see
# GHOSTFOLIO_TOOL_ALLOWLIST in apps/web/server/llm/mcp.ts); the write tools
# (delete_account, import_transactions, ...) are never reachable from chat.
GHOSTFOLIO_MCP_URL=https://your-ghostfolio-mcp.example.com/mcp
GHOSTFOLIO_MCP_BEARER=your-mcp-bearer-token

# === live trading safety rails (api) ===
# REAL (live-money) place/modify/cancel is refused with 403 unless this is
# true. The chat layer separately demands a typed confirmation phrase.
ALLOW_LIVE_TRADING=false
# Hard ceiling on the summed notional (qty x price, non-USD counted 1:1) of
# today's live orders, placement and modification included.
MAX_DAILY_LIVE_NOTIONAL_USD=1000

# === agents (TradingAgents pipeline) cost controls ===
# Daily USD ceiling across /agents/run, /agents/backtest and resume. Checked
# before every run and before every backtest pair; the api refuses runs when
# the DB (which holds the spend ledger) is unavailable.
AGENTS_DAILY_COST_USD_CAP=5.00
# Charged for models missing from the pricing table so an unknown model can
# never bypass the cap.
# AGENTS_FALLBACK_INPUT_USD_PER_1M=15
# AGENTS_FALLBACK_OUTPUT_USD_PER_1M=75

# === algo sandbox (api) ===
# Strategy code runs in a killable child process. Wall-clock limits for one
# live on_bar call and for a whole backtest; a strategy that overruns is
# killed and the tick/backtest records the error.
# ALGO_STRATEGY_TIMEOUT_SEC=10
# ALGO_BACKTEST_TIMEOUT_SEC=120

# === chat / portfolio tuning (web) ===
# Max agentic steps per chat turn (the client can pass a lower value).
# CHAT_MAX_STEPS=30
# Annual risk-free rate used for Sharpe in the MPT analysis (0.04 = 4%).
# PORTFOLIO_RISK_FREE_RATE=0
# Price-alert evaluation loop: disable entirely, or change the 60s cadence.
# PRICE_ALERTS_DISABLED=1
# PRICE_ALERTS_INTERVAL_MS=60000
# UTC hour the agents-cron container fires the nightly reflection + the daily
# net-worth / investments snapshot capture.
REFLECT_HOUR_UTC=08
